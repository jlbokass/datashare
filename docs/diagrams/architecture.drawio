Geometry x="640" y="347" width="213" height="137" as="geometry"/></mxCell><mxCell id="laravel" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Laravel REST API&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#566576;line-height:1.35&quot;&gt;Authentication · validation&lt;br&gt;Business rules · file access&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=11;strokeColor=#008b83;strokeWidth=2;fillColor=#ffffff;fontColor=#132838;" vertex="1" parent="1"><mxGeometry x="935" y="325" width="245" height="179" as="geometry"/></mxCell><mxCell id="postgres" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#566576;line-height:1.35&quot;&gt;Users · files metadata&lt;br&gt;Share tokens · expiry&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=11;strokeColor=#c2762f;strokeWidth=2;fillColor=#ffffff;fontColor=#132838;" vertex="1" parent="1"><mxGeometry x="1251" y="232" width="233" height="110" as="geometry"/></mxCell><mxCell id="storage" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Private file storage&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#566576;line-height:1.35&quot;&gt;Local disk (default)&lt;br&gt;or Garage S3 (isolated)&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=11;strokeColor=#c2762f;strokeWidth=2;fillColor=#ffffff;fontColor=#132838;" vertex="1" parent="1"><mxGeometry x="1251" y="448" width="233" height="110" as="geometry"/></mxCell><mxCell id="scheduler" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Scheduled cleanup&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#566576;line-height:1.35&quot;&gt;Daily expiry purge&lt;br&gt;Laravel schedule:work&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=11;strokeColor=#008b83;strokeWidth=2;fillColor=#ffffff;fontColor=#132838;" vertex="1" parent="1"><mxGeometry x="944" y="604" width="233" height="102" as="geometry"/></mxCell><mxCell id="e_sender" value="upload / account" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#47748a;endArrow=block;endFill=1;fontSize=13;fontColor=#385f72;labelBackgroundColor=#ffffff;align=center;" edge="1" parent="1" source="sender" target="angular"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_recipient" value="open share link" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#47748a;endArrow=block;endFill=1;fontSize=13;fontColor=#385f72;labelBackgroundColor=#ffffff;align=center;" edge="1" parent="1" source="recipient" target="angular"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_api_call" value="HTTP(S) · /api" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#47748a;endArrow=block;endFill=1;fontSize=13;fontColor=#385f72;labelBackgroundColor=#ffffff;align=center;" edge="1" parent="1" source="angular" target="nginx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_proxy" value="FastCGI" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#47748a;endArrow=block;endFill=1;fontSize=13;fontColor=#385f72;labelBackgroundColor=#ffffff;align=center;" edge="1" parent="1" source="nginx" target="laravel"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_db" value="SQL" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#47748a;endArrow=block;endFill=1;fontSize=13;fontColor=#385f72;labelBackgroundColor=#ffffff;align=center;" edge="1" parent="1" source="laravel" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_storage" value="I/O" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#47748a;endArrow=block;endFill=1;fontSize=13;fontColor=#385f72;labelBackgroundColor=#ffffff;align=center;" edge="1" parent="1" source="laravel" target="storage"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_cron" value="shared Laravel code" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#47748a;endArrow=block;endFill=1;fontSize=13;fontColor=#385f72;labelBackgroundColor=#ffffff;align=center;" edge="1" parent="1" source="scheduler" target="laravel"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="footnote" value="* Local HTTPS optional; public deployment requires HTTPS. Storage is private; Garage uses a separate DB. Scheduler shares Laravel code, not HTTP." style="text;html=1;align=left;whiteSpace=wrap;fontSize=14;fontColor=#526375;" vertex="1" parent="1"><mxGeometry x="40" y="786" width="1400" height="38" as="geometry"/></mxCell></root>
