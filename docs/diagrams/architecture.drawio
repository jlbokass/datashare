      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DataShare — logical architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=29;fontStyle=1;fontColor=#14283c;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1040" height="54" as="geometry"/></mxCell><mxCell id="subtitle" value="Release 25 Nov 2026  |  MVP US01–US06 and delivered extensions  |  Local only" style="text;html=1;align=left;fontSize=16;fontColor=#587185;" vertex="1" parent="1"><mxGeometry x="42" y="84" width="1250" height="30" as="geometry"/></mxCell><mxCell id="z_client" value="&lt;b&gt;PUBLIC CLIENT / BROWSER&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=19;spacingTop=9;strokeColor=#b4a6e0;fillColor=#f5f3ff;dashed=1;dashPattern=7 5;strokeWidth=1.7;fontColor=#4f6274;fontSize=15;" vertex="1" parent="1"><mxGeometry x="24" y="140" width="555" height="625" as="geometry"/></mxCell><mxCell id="z_server" value="&lt;b&gt;PRIVATE APPLICATION ENVIRONMENT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=19;spacingTop=9;strokeColor=#83c9bb;fillColor=#effbf9;dashed=1;dashPattern=7 5;strokeWidth=1.7;fontColor=#4f6274;fontSize=15;" vertex="1" parent="1"><mxGeometry x="606" y="140" width="914" height="625" as="geometry"/></mxCell><mxCell id="sender" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Registered sender&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#566576;line-height:1.35&quot;&gt;Upload and manage files&lt;br&gt;US01, US03–US06&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=11;strokeColor=#7059b8;strokeWidth=2;fillColor=#ffffff;fontColor=#132838;" vertex="1" parent="1"><mxGeometry x="62" y="258" width="200" height="105" as="geometry"/></mxCell><mxCell id="recipient" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Link recipient&lt;/b&gt;&lt;/div&gt;&lt;div style=&quo