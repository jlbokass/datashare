ght:1.5;margin:2px 13px&quot;&gt;+ idTelechargement: UUID {id}&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;+ dateTelechargement: DateTime&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;+ totalOctetsTelecharges: Long&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;+ nbFichiers: Integer&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#ffffff;strokeColor=#a66070;strokeWidth=2.4;dashed=1;dashPattern=6 4;fontColor=#173349;" vertex="1" parent="1"><mxGeometry x="710" y="855" width="500" height="310" as="geometry"/></mxCell><mxCell id="tag" value="&lt;div style=&quot;font-size:22px;font-weight:bold;background-color:#a66070;color:#ffffff;padding:11px 13px;&quot;&gt;TAG&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin:11px 13px 5px;color:#5d6f81&quot;&gt;TAGS (US08 — DELIVERED)&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;+ idTag: BIGINT {id}&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;+ libelle: String [1..30]&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;{unique within each file}&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#ffffff;strokeColor=#a66070;strokeWidth=2.4;dashed=1;dashPattern=6 4;fontColor=#173349;" vertex="1" parent="1"><mxGeometry x="1380" y="855" width="455" height="255" as="geometry"/></mxCell><mxCell id="optionalNote" value="&lt;b&gt;Delivery status&lt;/b&gt;&lt;br&gt;&lt;br&gt;US07: anonymous upload not implemented.&lt;br&gt;US09: per-file password hash delivered.&lt;br&gt;US10: daily cleanup delivered under US01.&lt;br&gt;&lt;br&gt;Download metrics: historical proposal only.&lt;br&gt;No download-event table is implemented." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spac