<mxfile host="app.diagrams.net" agent="DataShare P3 UML conceptual design" version="24.7.17" type="device"><diagram id="uml-mcd" name="DataShare — complete MCD"><mxGraphModel dx="1900" dy="1310" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1280" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="headline" value="DataShare — Conceptual UML class model" style="text;html=1;align=left;fontStyle=1;fontSize=31;fontColor=#193248;" vertex="1" parent="1"><mxGeometry x="45" y="22" width="1500" height="60" as="geometry"/></mxCell><mxCell id="subtitle" value="DESIGN-02 • Release 25 Nov 2026 • Solid: mandatory MVP • Dashed: optional, status indicated" style="text;html=1;align=left;fontSize=17;fontColor=#587085;" vertex="1" parent="1"><mxGeometry x="49" y="92" width="1750" height="44" as="geometry"/></mxCell><mxCell id="coreZone" value="MVP — US01 to US06 (OpenClassrooms)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=13;fillColor=#f3f7fb;strokeColor=#a9bfd3;dashed=0;strokeWidth=1.8;fontStyle=1;fontSize=17;fontColor=#4d6476;" vertex="1" parent="1"><mxGeometry x="25" y="151" width="1825" height="514" as="geometry"/></mxCell><mxCell id="optZone" value="OPTIONAL EXTENSIONS — delivered or historical (see labels)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=14;fillColor=#fff7f8;strokeColor=#cda4ab;dashed=1;dashPattern=9 5;strokeWidth=2;fontStyle=1;fontSize=17;fontColor=#855462;" vertex="1" parent="1"><mxGeometry x="25" y="711" width="1825" height="475" as="geometry"/></mxCell><mxCell id="user" value="&lt;div style=&quot;font-size:22px;font-weight:bold;background-color:#5268a8;color:#ffffff;padding:11px 13px;&quot;&gt;UTILISATEUR&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin:11px 13px 5px;color:#5d6f81&quot;&gt;USER&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;+ idUtilisateur: BIGINT {id}&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;+ email: String {unique}&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;- motDePasseHash: String&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;+ dateCreation: DateTime&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;+ nom: String [0..1]  (optional)&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;+ prenom: String [0..1]  (optional)&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;+ public_id: UUID {unique}&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#ffffff;strokeColor=#5268a8;strokeWidth=2.4;fontColor=#173349;" vertex="1" parent="1"><mxGeometry x="50" y="252" width="465" height="348" as="geometry"/></mxCell><mxCell id="transfer" value="&lt;div style=&quot;font-size:22px;font-weight:bold;background-color:#148c85;color:#ffffff;padding:11px 13px;&quot;&gt;TRANSFERT&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin:11px 13px 5px;color:#5d6f81&quot;&gt;TRANSFER&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;+ idTransfert: UUID {id}&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;+ tokenPartage: String {unique}&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;+ dateCreation: DateTime&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;+ dateExpiration: DateTime&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;+ titre: String [0..1] (not implemented)&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin:2px 13px&quot;&gt;+ message: Text [0..1] (not implemented)&lt;/div&