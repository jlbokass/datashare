<mxfile host="app.diagrams.net" agent="DataShare P3 design" version="24.7.17" type="device"><diagram id="datashare-mcd" name="Conceptual Data Model"><mxGraphModel dx="1620" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DataShare — conceptual data model (MCD)" style="text;html=1;align=left;verticalAlign=middle;fontSize=29;fontStyle=1;fontColor=#162a3c" vertex="1" parent="1"><mxGeometry x="53" y="24" width="1250" height="54" as="geometry"/></mxCell><mxCell id="subtitle" value="DRAFT v0.1 • OpenClassrooms US01–US06 • Merise-style entities, associations and cardinalities" style="text;html=1;align=left;fontSize=16;fontColor=#53667b" vertex="1" parent="1"><mxGeometry x="55" y="87" width="1370" height="36" as="geometry"/></mxCell><mxCell id="zone" value="CONCEPTUAL MODEL — NO FOREIGN KEYS / SQL TYPES" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=12;strokeColor=#bdd0df;fillColor=#f4f8fb;dashed=1;dashPattern=7 6;strokeWidth=1.6;fontSize=15;fontColor=#526679" vertex="1" parent="1"><mxGeometry x="30" y="150" width="1515" height="450" as="geometry"/></mxCell><mxCell id="user" value="&lt;div style=&quot;font-size:23px;font-weight:bold;letter-spacing:.4px&quot;&gt;UTILISATEUR&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#63758b;margin-bottom:16px&quot;&gt;USER&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #d7e0e8;margin:10px 0&quot;/&gt;&lt;div style=&quot;font-size:16px;line-height:1.3;padding-top:5px&quot;&gt;id_utilisateur — identifier&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.3;padding-top:5px&quot;&gt;email — unique&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.3;padding-top:5px&quot;&gt;mot_de_passe_haché&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.3;padding-top:5px&quot;&gt;date_inscription&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=17;spacingRight=13;spacingTop=13;fontColor=#16293e;fontSize=17;strokeColor=#5d5bb6;strokeWidth=2.2;fillColor=#ffffff;shadow=1" vertex="1" parent="1"><mxGeometry x="52" y="258" width="352" height="270" as="geometry"/></mxCell><mxCell id="transfer" value="&lt;div style=&quot;font-size:23px;font-weight:bold;letter-spacing:.4px&quot;&gt;TRANSFERT&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#63758b;margin-bottom:16px&quot;&gt;TRANSFER&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #d7e0e8;margin:10px 0&quot;/&gt;&lt;div style=&quot;font-size:16px;line-height:1.3;padding-top:5px&quot;&gt;id_transfert — identifier&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.3;padding-top:5px&quot;&gt;jeton_partage — unique&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.3;padding-top:5px&quot;&gt;date_creation&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.3;padding-top:5px&quot;&gt;date_expiration&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=17;spacingRight=13;spacingTop=13;fontColor=#16293e;fontSize=17;strokeColor=#07847a;strokeWidth=2.2;fillColor=#ffffff;shadow=1" vertex="1" parent="1"><mxGeometry x="599" y="258" width="357" height="270" as="geometry"/></mxCell><mxCell id="file" value="&lt;div style=&quot;font-size:23px;font-weight:bold;letter-spacing:.4px&quot;&gt;FICHIER&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#63758b;margin-bottom:16px&quot;&gt;FILE&lt;/div&gt;&lt;hr style=&quot;border:0;border-top:1px solid #d7e0e8;margin:10px 0&quot;/&gt;&lt;div style=&quot;font-size:16px;line-height:1.3;padding-top:5px&quot;&gt;id_fichier — identifier&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.3;padding-top:5px&quot;&gt;nom_original&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.3;padding-top:5px&quot;&gt;type_mime&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.3;padding-top:5px&quot;&gt;taille_octets&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.3;padding-top:5px&quot;&gt;date_envoi&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=17;spacingRight=13;spacingTop=13;fontColor=#16293e;fontSize=17;strokeColor=#b8772f;strokeWidth=2.2;fillColor=#ffffff;shadow=1" vertex="1" parent="1"><mxGeometry x="1150" y="258" width="365" height="270" as="geometry"/></mxCell><mxCell id="creates" value="&lt;b&gt;CRÉER&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#68788c&quot;&gt;CREATES&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#5d5bb6;fillColor=#ffffff;strokeWidth=2;fontSize=15;fontColor=#152b3a" vertex="1" parent="1"><mxGeometry x="452" y="344" width="103" height="103" as="geometry"/></mxCell><mxCell id="contains" value="&lt;b&gt;CONTENIR&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#68788c&quot;&gt;CONTAINS&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=#07847a;fillColor=#ffffff;strokeWidth=2;fontSize=15;fontColor=#152b3a" vertex="1" parent="1"><mxGeometry x="1000" y="344" width="103" height="103" as="geometry"/></mxCell><mxCell id="edge1" value="0,N" style="edgeStyle=none;html=1;rounded=0;strokeWidth=2;strokeColor=#466277;startArrow=none;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontColor=#1c3f55;fontSize=17;fontStyle=1;labelBackgroundColor=#f4f8fb;" edge="1" parent="1" source="user" target="creates"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="1,1" style="edgeStyle=none;html=1;rounded=0;strokeWidth=2;strokeColor=#466277;startArrow=none;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontColor=#1c3f55;fontSize=17;fontStyle=1;labelBackgroundColor=#f4f8fb;" edge="1" parent="1" source="creates" target="transfer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge3" value="1,N" style="edgeStyle=none;html=1;rounded=0;strokeWidth=2;strokeColor=#466277;startArrow=none;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontColor=#1c3f55;fontSize=17;fontStyle=1;labelBackgroundColor=#f4f8fb;" edge="1" parent="1" source="transfer" target="contains"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge4" value="1,1" style="edgeStyle=none;html=1;rounded=0;strokeWidth=2;strokeColor=#466277;startArrow=none;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontColor=#1c3f55;fontSize=17;fontStyle=1;labelBackgroundColor=#f4f8fb;" edge="1" parent="1" source="contains" target="file"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="key-legend" value="Notation: 0,N = none or many; 1,1 = exactly one; 1,N = one or many. Cardinalities describe how many instances of an association each entity participates in." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=19;fillColor=#eff5fc;strokeColor=#b5cbe3;fontSize=14;fontColor=#24445d" vertex="1" parent="1"><mxGeometry x="55" y="620" width="1455" height="58" as="geometry"/></mxCell><mxCell id="rule0" value="&lt;b&gt;R1&lt;/b&gt;  MVP: each transfer has exactly one registered owner." style="text;html=1;align=left;verticalAlign=middle;fontColor=#364b61;fontSize=15" vertex="1" parent="1"><mxGeometry x="68" y="702" width="1420" height="32" as="geometry"/></mxCell><mxCell id="rule1" value="&lt;b&gt;R2&lt;/b&gt;  One transfer may hold several files under one share token." style="text;html=1;align=left;verticalAlign=middle;fontColor=#364b61;fontSize=15" vertex="1" parent="1"><mxGeometry x="68" y="741" width="1420" height="32" as="geometry"/></mxCell><mxCell id="rule2" value="&lt;b&gt;R3&lt;/b&gt;  US06 deletes one file; remove transfer when last file goes." style="text;html=1;align=left;verticalAlign=middle;fontColor=#364b61;fontSize=15" vertex="1" parent="1"><mxGeometry x="68" y="780" width="1420" height="32" as="geometry"/></mxCell><mxCell id="rule3" value="&lt;b&gt;R4&lt;/b&gt;  Expiry belongs to transfer (default 7 days, max 7 days)." style="text;html=1;align=left;verticalAlign=middle;fontColor=#364b61;fontSize=15" vertex="1" parent="1"><mxGeometry x="68" y="819" width="1420" height="32" as="geometry"/></mxCell><mxCell id="rule4" value="&lt;b&gt;R5&lt;/b&gt;  Link status is derived; bytes stay outside PostgreSQL." style="text;html=1;align=left;verticalAlign=middle;fontColor=#364b61;fontSize=15" vertex="1" parent="1"><mxGeometry x="68" y="858" width="1420" height="32" as="geometry"/></mxCell><mxCell id="footnote" value="DESIGN DECISIONS TO REVIEW: one token per transfer; individual file deletion; delete empty transfer. Physical keys and storage schema belong to future implementation." style="text;html=1;align=left;fontSize=13;fontColor=#697b90" vertex="1" parent="1"><mxGeometry x="55" y="907" width="1470" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>