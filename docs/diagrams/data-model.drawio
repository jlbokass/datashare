<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="DataShare P3 UML conceptual design" version="24.7.17" type="device"><diagram id="uml-mvp" name="MVP — UML classes"><mxGraphModel dx="1660" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1670" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DataShare — UML conceptual class model" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=31;fontColor=#153047;" vertex="1" parent="1"><mxGeometry x="46" y="28" width="1580" height="60" as="geometry"/></mxCell><mxCell id="subtitle" value="DESIGN-02 • OpenClassrooms US01–US06 • Draft v0.2 for review" style="text;html=1;align=left;fontSize=17;fontColor=#65778a;" vertex="1" parent="1"><mxGeometry x="48" y="95" width="1574" height="39" as="geometry"/></mxCell><mxCell id="zone" value="MVP — conceptual classes (UML notation)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;strokeColor=#b9cede;fillColor=#f2f7fa;strokeWidth=1.8;dashed=1;dashPattern=8 5;fontSize=15;fontColor=#536a7b;" vertex="1" parent="1"><mxGeometry x="23" y="170" width="1624" height="509" as="geometry"/></mxCell><mxCell id="user" value="&lt;div style=&quot;background-color:#5268a8;color:#ffffff;padding:18px 18px;font-weight:700;font-size:22px&quot;&gt;UTILISATEUR&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt; — USER&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:16px 16px 10px 16px;font-size:17px;line-height:1.47&quot;&gt;+ idUtilisateur: UUID {id}&lt;br&gt;+ email: String {unique}&lt;br&gt;- motDePasseHash: String&lt;br&gt;+ dateCreation: DateTime&lt;br&gt;+ nom: String [0..1]&lt;br&gt;+ prenom: String [0..1]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#ffffff;strokeWidth=2.5;strokeColor=#5268a8;fontColor=#183047;" vertex="1" parent="1"><mxGeometry x="50" y="254" width="425" height="379" as="geometry"/></mxCell><mxCell id="transfer" value="&lt;div style=&quot;background-color:#148c85;color:#ffffff;padding:18px 18px;font-weight:700;font-size:22px&quot;&gt;TRANSFERT&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt; — TRANSFER&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:16px 16px 10px 16px;font-size:17px;line-height:1.47&quot;&gt;+ idTransfert: UUID {id}&lt;br&gt;+ tokenPartage: String {unique}&lt;br&gt;+ dateCreation: DateTime&lt;br&gt;+ dateExpiration: DateTime&lt;br&gt;+ titre: String [0..1]&lt;br&gt;+ message: Text [0..1]&lt;br&gt;/ statut: EtatLien {derived}&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#ffffff;strokeWidth=2.5;strokeColor=#148c85;fontColor=#183047;" vertex="1" parent="1"><mxGeometry x="630" y="254" width="421" height="379" as="geometry"/></mxCell><mxCell id="file" value="&lt;div style=&quot;background-color:#c08939;color:#ffffff;padding:18px 18px;font-weight:700;font-size:22px&quot;&gt;FICHIER&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt; — FILE&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:16px 16px 10px 16px;font-size:17px;line-height:1.47&quot;&gt;+ idFichier: UUID {id}&lt;br&gt;+ nomOriginal: String&lt;br&gt;+ tailleOctets: Long&lt;br&gt;+ typeMime: String&lt;br&gt;+ dateEnvoi: DateTime&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#ffffff;strokeWidth=2.5;strokeColor=#c08939;fontColor=#183047;" vertex="1" parent="1"><mxGeometry x="1200" y="254" width="426" height="379" as="geometry"/></mxCell><mxCell id="association1" value="" style="edgeStyle=none;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#485f71;strokeWidth=2.8;startArrow=none;endArrow=none;" edge="1" parent="1" source="user" target="transfer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="association2" value="" style="edgeStyle=none;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#485f71;strokeWidth=2.8;startArrow=diamond;startFill=1;startSize=14;endArrow=none;" edge="1" parent="1" source="transfer" target="file"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ownsLeft" value="1" style="text;html=1;align=center;fontStyle=1;fontSize=17;fontColor=#223f56;fillColor=#f2f7fa;" vertex="1" parent="1"><mxGeometry x="470" y="412" width="34" height="28" as="geometry"/></mxCell><mxCell id="ownsRight" value="0..*" style="text;html=1;align=center;fontStyle=1;fontSize=17;fontColor=#223f56;fillColor=#f2f7fa;" vertex="1" parent="1"><mxGeometry x="578" y="412" width="50" height="28" as="geometry"/></mxCell><mxCell id="ownsVerb" value="crée / creates" style="text;html=1;align=center;fontStyle=1;fontSize=17;fontColor=#223f56;fillColor=#f2f7fa;" vertex="1" parent="1"><mxGeometry x="515" y="366" width="112" height="26" as="geometry"/></mxCell><mxCell id="fileLeft" value="1" style="text;html=1;align=center;fontStyle=1;fontSize=17;fontColor=#223f56;fillColor=#f2f7fa;" vertex="1" parent="1"><mxGeometry x="1053" y="412" width="30" height="28" as="geometry"/></mxCell><mxCell id="fileRight" value="1..*" style="text;html=1;align=center;fontStyle=1;fontSize=17;fontColor=#223f56;fillColor=#f2f7fa;" vertex="1" parent="1"><mxGeometry x="1143" y="412" width="55" height="28" as="geometry"/></mxCell><mxCell id="fileVerb" value="contient / contains" style="text;html=1;align=center;fontStyle=1;fontSize=17;fontColor=#223f56;fillColor=#f2f7fa;" vertex="1" parent="1"><mxGeometry x="1072" y="366" width="129" height="26" as="geometry"/></mxCell><mxCell id="note" value="UML multiplicity is written next to the associated class:  User (1) — (0..*) Transfer  •  Transfer (1) — (1..*) File.  Filled diamond at TRANSFERT = composition." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#e9f1fa;strokeColor=#b9cede;fontSize=17;fontColor=#284662;" vertex="1" parent="1"><mxGeometry x="58" y="715" width="1555" height="66" as="geometry"/></mxCell><mxCell id="note0" value="• MVP: each transfer belongs to exactly one registered user; each file belongs to one transfer." style="text;html=1;align=left;fontSize=16;fontColor=#40586c;" vertex="1" parent="1"><mxGeometry x="67" y="807" width="1550" height="34" as="geometry"/></mxCell><mxCell id="note1" value="• US06: deleting one file preserves its siblings; deleting the last file removes the empty transfer (proposal)." style="text;html=1;align=left;fontSize=16;fontColor=#40586c;" vertex="1" parent="1"><mxGeometry x="67" y="850" width="1550" height="34" as="geometry"/></mxCell><mxCell id="note2" value="• Expiry: seven days by default, at most seven days; link status is derived (not stored)." style="text;html=1;align=left;fontSize=16;fontColor=#40586c;" vertex="1" parent="1"><mxGeometry x="67" y="893" width="1550" height="34" as="geometry"/></mxCell><mxCell id="note3" value="• Optional fields: nom/prenom and titre/message are not required by the official US." style="text;html=1;align=left;fontSize=16;fontColor=#40586c;" vertex="1" parent="1"><mxGeometry x="67" y="936" width="1550" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="uml-extensions" name="Optional — extensions"><mxGraphModel dx="1660" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="930" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DataShare — Optional extensions (not MVP)" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=31;fontColor=#153047;" vertex="1" parent="1"><mxGeometry x="46" y="28" width="1450" height="60" as="geometry"/></mxCell><mxCell id="subtitle" value="Proposals only: US09 password protection and optional download auditing" style="text;html=1;align=left;fontSize=17;fontColor=#65778a;" vertex="1" parent="1"><mxGeometry x="48" y="95" width="1444" height="39" as="geometry"/></mxCell><mxCell id="zone" value="ADVANCED FEATURE STUDY — not in mandatory MVP" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;strokeColor=#b9cede;fillColor=#f2f7fa;strokeWidth=1.8;dashed=1;dashPattern=8 5;fontSize=15;fontColor=#536a7b;" vertex="1" parent="1"><mxGeometry x="23" y="170" width="1494" height="509" as="geometry"/></mxCell><mxCell id="fileAdv" value="&lt;div style=&quot;background-color:#c08939;color:#ffffff;padding:18px 18px;font-weight:700;font-size:22px&quot;&gt;FICHIER&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt; — FILE (from MVP)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:16px 16px 10px 16px;font-size:17px;line-height:1.47&quot;&gt;+ idFichier: UUID {id}&lt;br&gt;+ nomOriginal: String&lt;br&gt;... existing MVP attributes ...&lt;br&gt;* optional motDePasseHash (US09)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#ffffff;strokeWidth=2.5;strokeColor=#c08939;fontColor=#183047;" vertex="1" parent="1"><mxGeometry x="86" y="276" width="455" height="335" as="geometry"/></mxCell><mxCell id="download" value="&lt;div style=&quot;background-color:#b66c7a;color:#ffffff;padding:18px 18px;font-weight:700;font-size:22px&quot;&gt;TÉLÉCHARGEMENT&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt; — DOWNLOAD EVENT — optional telemetry&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:16px 16px 10px 16px;font-size:17px;line-height:1.47&quot;&gt;+ idTelechargement: UUID {id}&lt;br&gt;+ dateTelechargement: DateTime&lt;br&gt;+ adresseIpHash: String [0..1]&lt;br&gt;+ userAgent: String [0..1]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#ffffff;strokeWidth=2.5;strokeColor=#b66c7a;fontColor=#183047;" vertex="1" parent="1"><mxGeometry x="904" y="276" width="557" height="335" as="geometry"/></mxCell><mxCell id="advAssociation" value="" style="edgeStyle=none;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#876879;strokeWidth=2.5;startArrow=none;endArrow=none;dashed=1;" edge="1" parent="1" source="fileAdv" target="download"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="advL" value="1" style="text;html=1;align=center;fontStyle=1;fontSize=18;fontColor=#704d5c;fillColor=#f2f7fa;" vertex="1" parent="1"><mxGeometry x="548" y="414" width="28" height="30" as="geometry"/></mxCell><mxCell id="advR" value="0..*" style="text;html=1;align=center;fontStyle=1;fontSize=18;fontColor=#704d5c;fillColor=#f2f7fa;" vertex="1" parent="1"><mxGeometry x="840" y="414" width="58" height="30" as="geometry"/></mxCell><mxCell id="advLabel" value="journalise / logs" style="text;html=1;align=center;fontStyle=1;fontSize=18;fontColor=#704d5c;fillColor=#f2f7fa;" vertex="1" parent="1"><mxGeometry x="648" y="362" width="144" height="29" as="geometry"/></mxCell><mxCell id="advNote0" value="• Optional DOWNLOAD EVENT is not required by OpenClassrooms. Tracking each individual file needs a link to FICHIER, not just TRANSFERT." style="text;html=1;align=left;whiteSpace=wrap;fontSize=16;fontColor=#465b72" vertex="1" parent="1"><mxGeometry x="55" y="714" width="1420" height="45" as="geometry"/></mxCell><mxCell id="advNote1" value="• US09 specifies protection of a file; placing its password hash only on TRANSFERT would protect the entire shared batch instead." style="text;html=1;align=left;whiteSpace=wrap;fontSize=16;fontColor=#465b72" vertex="1" parent="1"><mxGeometry x="55" y="762" width="1420" height="45" as="geometry"/></mxCell><mxCell id="advNote2" value="• IP hashes and user agents involve privacy and retention decisions (GDPR); leave unimplemented until justified." style="text;html=1;align=left;whiteSpace=wrap;fontSize=16;fontColor=#465b72" vertex="1" parent="1"><mxGeometry x="55" y="810" width="1420" height="45" as="geometry"/></mxCell><mxCell id="advNote3" value="• The physical model may introduce a storage key and SHA-256 checksum; they are not mandatory conceptual attributes." style="text;html=1;align=left;whiteSpace=wrap;fontSize=16;fontColor=#465b72" vertex="1" parent="1"><mxGeometry x="55" y="858" width="1420" height="45" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>