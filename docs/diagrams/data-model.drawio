ates" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#30495e;align=center;fontStyle=1;fontSize=16;fillColor=#f3f7fb;" vertex="1" parent="1"><mxGeometry x="548" y="380" width="124" height="28" as="geometry"/></mxCell><mxCell id="tCard2" value="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#30495e;align=center;fontStyle=1;fontSize=16;fillColor=#f3f7fb;" vertex="1" parent="1"><mxGeometry x="1210" y="420" width="36" height="25" as="geometry"/></mxCell><mxCell id="fCard" value="1..*" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#30495e;align=center;fontStyle=1;fontSize=16;fillColor=#f3f7fb;" vertex="1" parent="1"><mxGeometry x="1320" y="420" width="49" height="25" as="geometry"/></mxCell><mxCell id="tfName" value="contient / contains" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#30495e;align=center;fontStyle=1;fontSize=16;fillColor=#f3f7fb;" vertex="1" parent="1"><mxGeometry x="1225" y="380" width="150" height="28" as="geometry"/></mxCell><mxCell id="tEventCard" value="0..1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#30495e;align=center;fontStyle=1;fontSize=16;fillColor=#fff7f8;" vertex="1" parent="1"><mxGeometry x="913" y="617" width="60" height="26" as="geometry"/></mxCell><mxCell id="eCard" value="0..*" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#30495e;align=center;fontStyle=1;fontSize=16;fillColor=#fff7f8;" vertex="1" parent="1"><mxGeometry x="913" y="813" width="60" height="26" as="geometry"/></mxCell><mxCell id="teName" value="concerne / traces" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#30495e;align=center;fontStyle=1;fontSize=16;fillColor=#fff7f8;" vertex="1" parent="1"><mxGeometry x="979" y="720" width="185" height="30" as="geometry"/></mxCell><mxCell id="fTagCard" value="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlig